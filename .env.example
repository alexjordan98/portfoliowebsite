# Public (inlined into the client bundle at build time; redeploy after changing)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
NEXT_PUBLIC_LINKEDIN=https://www.linkedin.com/in/your-profile
NEXT_PUBLIC_GITHUB=https://github.com/your-username
NEXT_PUBLIC_ROTH_GITHUB=https://github.com/your-username/roth-repo
NEXT_PUBLIC_KONGONI=https://example.com

# Server-only (contact form: /api/contact via Amazon SES)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-ses-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-ses-iam-secret-access-key
SES_SENDER_EMAIL=contact@example.com
SES_RECIPIENT_EMAIL=you@example.com
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key
